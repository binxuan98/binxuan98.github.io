  "narrative": {
    "northStar": "智研社数字孪生园区",
    "overview": "本文件仅记录 `/society/` 已实现的视觉系统，不是个人学术网站的全站重设计规范。用户已确认智慧城市数字孪生方向，并要求突出智研社教学、科研和算力。深海蓝工作台承托程序化三维园区，青绿色承担选中反馈，窄边面板组织教学与培养内容。\n\n园区以模型体量、道路、绿化、建筑窗格和协同连线形成可探索空间；它是概念模型，不是真实地理测绘、BIM 复原或实时监测。图像策略为 Three.js 几何场景与既有公众号二维码，未使用生成式图片。以下名称是对已确认方向与真实实现的描述。",
    "keyCharacteristics": [
      "深海蓝背景与低饱和面板，明亮青绿选中反馈。",
      "桌面以三维园区为主体，两侧信息面板和五项空间导航互相对应。",
      "小圆角、细边线和描边图标，空间模型承担主要景深。",
      "降低动态效果与无 WebGL 内容回退均有实现。"
    ],
    "rules": [],
    "dos": [
      "Do 将本规范限定于 `/society/`；其他路由沿用其独立视觉系统。",
      "Do 让地标、底部入口和空间档案保持同一个选中项。",
      "Do 保留原始二维码和概念示意说明。",
      "Do 在窄屏保留完整正文与固定导航的底部安全空间。",
      "Do 保持键盘焦点可见，保留减少动态效果与内容回退。"
    ],
    "donts": [
      "Don't 将概念建筑、交通与连线表述为真实位置、实时设备或监测数据。",
      "Don't 用生成式效果图替代当前可操作的几何园区，或重新绘制既有二维码。",
      "Don't 把地图作为唯一的信息访问入口。"
    ]
  }
}
